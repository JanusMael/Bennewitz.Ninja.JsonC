<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <!-- The id below is derived from the stem passed to `dotnet new bbpkg -n <Stem>`; the assembly
         name stays the bare stem, which is the convention across these repos. -->
    <PackageId>Bennewitz.Ninja.JsonC</PackageId>
    <AssemblyName>JsonC</AssemblyName>
    <Description>
      Comment- and formatting-preserving JSONC reader plus an edit-based writer.

      Writes by replacing the minimal text span for each changed path rather than
      re-serializing the document, so comments, blank lines, key order, indentation
      style, and line endings survive a save untouched — they are never rewritten.

      Framework-only by design: no package references. It is a text-editing
      component, and staying dependency-free is what keeps it testable in isolation
      and safe to reason about, since a bug here corrupts user config.
    </Description>
    <PackageTags>jsonc;json;comments;config;parser;editor;formatting-preserving</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Carried from the project this was moved out of, which suppressed it too: a few enum members
         have no doc comment, and the move keeps the source byte for byte. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
